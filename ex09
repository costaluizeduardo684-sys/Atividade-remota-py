
############################################################
# Descrição: Calcula a soma dos números pares de 1 até 500.
# Parâmetros de entrada: Não possui entrada do usuário.
# Valores de saída: Soma de todos os números pares.
# Autor: Luiz Eduardo Santos Costa
############################################################

soma = 0

for numero in range(1, 501):
    if numero % 2 == 0:
        soma += numero

print("A soma dos números pares de 1 a 500 é:", soma)
