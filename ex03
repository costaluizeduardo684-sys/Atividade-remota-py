
############################################################
# Descrição: Identifica o sexo informado por uma letra.
# Parâmetros de entrada: Uma letra F ou M.
# Valores de saída: Feminino, Masculino ou Sexo Inválido.
# Autor: Luiz Eduardo Santos Costa 
############################################################

letra = input("Digite F ou M: ").strip().upper()

if letra == "F":
    print("F - Feminino")
elif letra == "M":
    print("M - Masculino")
else:
    print("Sexo Inválido")
